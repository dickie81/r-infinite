/-! ## 6. The ladder -/

/-- **The certificate at `cZ`, ball-uniform inputs discharged**: three point values remain. -/
theorem dh_zero_near_of_center {pr pi ar : ℝ}
    (hPr : |PReG cZ 28 12| ≤ pr) (hPi : |PImG cZ 28 12| ≤ pi) (hAr : ar ≤ |AReG cZ 28 12|)
    (hmargin : 2 * (pr + pi + (53 / 5000000 : ℝ)) < ar * (1 / 200 : ℝ) - (74287 / 800 : ℝ) * (1 / 200 : ℝ) ^ 2) :
    ∃ ρ, dh ρ = 0 ∧ ‖ρ - cZ‖ < (1 / 200 : ℝ) :=
  dh_zero_near_of_elementaryG (by norm_num) (by rw [cZ_im]; norm_num) hPr hPi hAr
    (fun _ hz => m2_ball hz) (fun _ hz => norm_dh_sub_dhEM_le_ball hz) hmargin

/-- **The open inputs with fixed tolerances**: `|Re fEM(c)| ≤ 3 / 10000`, `|Im fEM(c)| ≤ 3 / 10000`,
`Re fEM′(c) ≥ 17 / 20` (true values `2.148e-7`, `-1.961e-6`, `0.867936`). -/
theorem dh_zero_near_of_center' (hPr : |PReG cZ 28 12| ≤ (3 / 10000 : ℝ)) (hPi : |PImG cZ 28 12| ≤ (3 / 10000 : ℝ))
    (hAr : (17 / 20 : ℝ) ≤ AReG cZ 28 12) : ∃ ρ, dh ρ = 0 ∧ ‖ρ - cZ‖ < (1 / 200 : ℝ) :=
  dh_zero_near_of_center hPr hPi (hAr.trans (le_abs_self _)) (by norm_num)

