/-- The tail constant: `6.860363 ≤ Cin(351π/2)` (the rational chain `cin_of_check`, kernel-checked). -/
theorem cinE : (6860363 / 1000000 : ℝ) ≤ Cin (((350 + 1 : ℕ) : ℝ) * π / 2) := by
  have h := cin_of_check (N := 350 + 1) (by norm_num) (b := 4080254 / 10 ^ 6) (by decide +kernel)
  push_cast at h ⊢; linarith

theorem hKlo_E : Real.log ((5 - 1 : ℕ) : ℝ) ≤ 2 * (4 / 5 : ℝ) := by
  have := Real.log_two_lt_d9; norm_num; rw [log_four_eq]; norm_num at this ⊢; linarith

theorem hKhi_E : 2 * (4 / 5 : ℝ) < Real.log (5 : ℕ) := by
  have := log_five_gt; push_cast; norm_num at this ⊢; linarith

def gramE : Matrix (Fin (350 + 2)) (Fin (350 + 2)) ℝ := Matrix.of fun i j => gC (4 / 5 : ℝ) i j

/-- **The even certificate** (checked by `frontier/nullvec/kpar_cert.py cert even 0.80 350 0.000000000000000003`). -/
def CertE : Prop :=
  (∀ k : ℕ, k < 350 → psiE (k + 1) ≤ modeE (4 / 5 : ℝ) ((k : ℤ) + 1)) ∧ gramE.PosDef ∧
    (3 / 1000000000000000000 : ℝ) ≤ kappaW (4 / 5 : ℝ) (6860363 / 1000000 : ℝ) 5 ∧
    ((kappaW (4 / 5 : ℝ) (6860363 / 1000000 : ℝ) 5 - (3 / 1000000000000000000 : ℝ)) • gramE
      + gramE * diagonal (fun i : Fin (350 + 2) => sfunW (4 / 5 : ℝ) (tauW (4 / 5 : ℝ) (6860363 / 1000000 : ℝ) 5) (wP (4 / 5 : ℝ) 5) psiE i)
        * gramE).PosSemidef

/-- **Even-sector positivity up to `a* = 0.80`**: granted `CertE`, every normalised even probe
at every support `0 < a ≤ 0.80` has `Q(g) ≥ 0.000000000000000003`. -/
theorem weilQ_ge_E {a : ℝ} (ha : 0 < a) (hab : a ≤ (4 / 5 : ℝ)) (hc : CertE) {g : ℝ → ℝ}
    (hp : Probe a g) (hn : normSq g = 1) : (3 / 1000000000000000000 : ℝ) ≤ weilQ a g :=
  weilQ_ge_of_certW (K := 5) (N := 350) (by norm_num) (by norm_num) (by norm_num) hKlo_E hKhi_E cinE psiE
    hc.1 hc.2.1 hc.2.2.1 hc.2.2.2 ha hab hp hn


/-! ## The odd sector at `a* = 0.80`: `N = 350`, primes `n < 5`, `ε = 0.000000000000005` -/

/-! The odd sector reuses the even sector's certified `ψ̲` list (`kpar_cert_odd_0.80.json` has the
same values), tail constant `cinE` and prime-window bounds `hKlo_E`, `hKhi_E`. -/

def gramO : Matrix (Fin (350 + 1)) (Fin (350 + 1)) ℝ := Matrix.of fun i j => gCO (4 / 5 : ℝ) i j

/-- **The odd certificate** (checked by `frontier/nullvec/kpar_cert.py cert odd 0.80 350 0.000000000000005`). -/
def CertO : Prop :=
  (∀ k : ℕ, k < 350 → psiE (k + 1) ≤ modeE (4 / 5 : ℝ) ((k : ℤ) + 1)) ∧ gramO.PosDef ∧
    (1 / 200000000000000 : ℝ) ≤ kappaW (4 / 5 : ℝ) (6860363 / 1000000 : ℝ) 5 ∧
    ((kappaW (4 / 5 : ℝ) (6860363 / 1000000 : ℝ) 5 - (1 / 200000000000000 : ℝ)) • gramO
      + gramO * diagonal (fun i : Fin (350 + 1) => sfunO (4 / 5 : ℝ) (tauW (4 / 5 : ℝ) (6860363 / 1000000 : ℝ) 5) (wP (4 / 5 : ℝ) 5) psiE i)
        * gramO).PosSemidef

/-- **Odd-sector positivity up to `a* = 0.80`**: granted `CertO`, every normalised odd probe
at every support `0 < a ≤ 0.80` has `Q(g) ≥ 0.000000000000005`. -/
theorem weilQ_ge_O {a : ℝ} (ha : 0 < a) (hab : a ≤ (4 / 5 : ℝ)) (hc : CertO) {g : ℝ → ℝ}
    (hp : OProbe a g) (hn : normSq g = 1) : (1 / 200000000000000 : ℝ) ≤ weilQg a g :=
  weilQodd_ge_of_certW (K := 5) (N := 350) (by norm_num) (by norm_num) (by norm_num) hKlo_E hKhi_E cinE psiE
    hc.1 hc.2.1 hc.2.2.1 hc.2.2.2 ha hab hp hn

/-- **Weil positivity for every real `g`**, granted both certificates: `Q(g) ≥ min(ε_e, ε_o)‖g‖²` at every support
`0 < a ≤ 4/5`. -/
theorem weilQg_ge_both {a : ℝ} (ha : 0 < a) (hab : a ≤ (4 / 5 : ℝ)) (hE : CertE) (hO : CertO) {g : ℝ → ℝ}
    (hg : SProbe a g) : min (3 / 1000000000000000000 : ℝ) (1 / 200000000000000 : ℝ) * normSq g ≤ weilQg a g :=
  weilQg_ge_min ha (fun _ hp hn => weilQ_ge_E ha (by linarith) hE hp hn)
    (fun _ hp hn => weilQ_ge_O ha (by linarith) hO hp hn) hg

