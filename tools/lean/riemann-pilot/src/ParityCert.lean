/-- The tail constant: `6.297902 ≤ Cin(201π/2)` (the rational chain `cin_of_check`, kernel-checked). -/
theorem cinE : (3148951 / 500000 : ℝ) ≤ Cin (((200 + 1 : ℕ) : ℝ) * π / 2) := by
  have h := cin_of_check (N := 200 + 1) (by norm_num) (b := 3517793 / 10 ^ 6) (by decide +kernel)
  push_cast at h ⊢; linarith

theorem hKlo_E : Real.log ((4 - 1 : ℕ) : ℝ) ≤ 2 * (69 / 100 : ℝ) := by
  have := log_three_le; norm_num at this ⊢; linarith

theorem hKhi_E : 2 * (69 / 100 : ℝ) < Real.log (4 : ℕ) := by
  have := Real.log_two_gt_d9; push_cast; rw [log_four_eq]; norm_num at this ⊢; linarith

def gramE : Matrix (Fin (200 + 2)) (Fin (200 + 2)) ℝ := Matrix.of fun i j => gC (69 / 100 : ℝ) i j

/-- **The even certificate** (checked by `frontier/nullvec/kpar_cert.py cert even 0.69 200 0.0000000000001`). -/
def CertE : Prop :=
  (∀ k : ℕ, k < 200 → psiE (k + 1) ≤ modeE (69 / 100 : ℝ) ((k : ℤ) + 1)) ∧ gramE.PosDef ∧
    (1 / 10000000000000 : ℝ) ≤ kappaW (69 / 100 : ℝ) (3148951 / 500000 : ℝ) 4 ∧
    ((kappaW (69 / 100 : ℝ) (3148951 / 500000 : ℝ) 4 - (1 / 10000000000000 : ℝ)) • gramE
      + gramE * diagonal (fun i : Fin (200 + 2) => sfunW (69 / 100 : ℝ) (tauW (69 / 100 : ℝ) (3148951 / 500000 : ℝ) 4) (wP (69 / 100 : ℝ) 4) psiE i)
        * gramE).PosSemidef

/-- **Even-sector positivity up to `a* = 0.69`**: granted `CertE`, every normalised even probe
at every support `0 < a ≤ 0.69` has `Q(g) ≥ 0.0000000000001`. -/
theorem weilQ_ge_E {a : ℝ} (ha : 0 < a) (hab : a ≤ (69 / 100 : ℝ)) (hc : CertE) {g : ℝ → ℝ}
    (hp : Probe a g) (hn : normSq g = 1) : (1 / 10000000000000 : ℝ) ≤ weilQ a g :=
  weilQ_ge_of_certW (K := 4) (N := 200) (by norm_num) (by norm_num) (by norm_num) hKlo_E hKhi_E cinE psiE
    hc.1 hc.2.1 hc.2.2.1 hc.2.2.2 ha hab hp hn


