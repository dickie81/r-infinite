/-- **The certificate at `cZ`, ball-uniform inputs discharged**: three point values remain. -/
theorem dh_zero_near_of_center {pr pi ar : ℝ}
    (hPr : |PReG cZ 41 12| ≤ pr) (hPi : |PImG cZ 41 12| ≤ pi) (hAr : ar ≤ |AReG cZ 41 12|)
    (hmargin : 2 * (pr + pi + (83 / 5000000 : ℝ)) < ar * (1 / 500 : ℝ) - (423127 / 2450 : ℝ) * (1 / 500 : ℝ) ^ 2) :
    ∃ ρ, dh ρ = 0 ∧ ‖ρ - cZ‖ < (1 / 500 : ℝ) :=
  dh_zero_near_of_elementaryG (by norm_num) (by rw [cZ_im]; norm_num) hPr hPi hAr
    (fun _ hz => m2_ball hz) (fun _ hz => norm_dh_sub_dhEM_le_ball hz) hmargin

/-- **The open inputs with fixed tolerances**: `|Re fEM(c)| ≤ 9 / 100000`, `|Im fEM(c)| ≤ 9 / 100000`,
`Re fEM′(c) ≥ 3 / 5` (true values `3.014e-6`, `2.495e-6`, `0.61788`). -/
theorem dh_zero_near_of_center' (hPr : |PReG cZ 41 12| ≤ (9 / 100000 : ℝ)) (hPi : |PImG cZ 41 12| ≤ (9 / 100000 : ℝ))
    (hAr : (3 / 5 : ℝ) ≤ AReG cZ 41 12) : ∃ ρ, dh ρ = 0 ∧ ‖ρ - cZ‖ < (1 / 500 : ℝ) :=
  dh_zero_near_of_center hPr hPi (hAr.trans (le_abs_self _)) (by norm_num)

