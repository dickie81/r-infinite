import DHLocateNum
import DHLocate2Num
import DHLocate3Num
import DHLocate4Num
import DHNegIndex

/-!
# Four located off-line zeros of `dh`, and the Weil index of `Q_dh` is at least `4`

`dh_zeros_located_four` collects the four zero-location certificates: `dh_zero_located`
(`DHLocateNum`; centre `cLoc = 1617/2000 + (856993/10000) i`, radius `1/100`) and `dh_zero_located_2`,
`dh_zero_located_3`, `dh_zero_located_4` (`DHLocate2Num`, `DHLocate3Num`, `DHLocate4Num`, generated by
`gen_locate_zero.py`; centres `Z2.cZ = 65083/100000 + (11416334/100000) i`,
`Z3.cZ = 57436/100000 + (16647931/100000) i`, `Z4.cZ = 72426/100000 + (17670246/100000) i`; radii `1/200`,
`1/500`, `1/150`).

`negIndex_ge_four` is `negIndex_ge_of_located` (`DHNegIndex`) at `n = 4` with these centres
(`negIndex_ge_four_of`): each radius is at most `1/100`; every centre is right of `Re s = 1/100` and at
least `1/100` from the critical line (real parts `0.8085, 0.65083, 0.57436, 0.72426`); and every centre
is at least `2/100` from each image of every other centre under the maps `s ↦ s, 1 − s, s̄, 1 − s̄`, by
the imaginary parts alone (`sep_of_im`: `s ↦ s` and `s ↦ 1 − s̄` keep `Im s`, `s ↦ 1 − s` and `s ↦ s̄`
negate it, and the four ordinates `85.70, 114.16, 166.48, 176.70` are positive and pairwise more than
`2/100` apart).
-/

open Complex
open scoped ComplexConjugate

noncomputable section

namespace PsiOmega.Locate

/-- The four centres. -/
def cFour : Fin 4 → ℂ := ![cLoc, Z2.cZ, Z3.cZ, Z4.cZ]

/-- Separation from the imaginary parts: `|Im d − Im c| ≥ 2/100` and `|Im d + Im c| ≥ 2/100` put `d` at
least `2/100` from each of `c`, `1 − c`, `c̄`, `1 − c̄`. -/
theorem sep_of_im {c d : ℂ} (h1 : 2 / 100 ≤ |d.im - c.im|) (h2 : 2 / 100 ≤ |d.im + c.im|) :
    2 / 100 ≤ ‖d - c‖ ∧ 2 / 100 ≤ ‖d - (1 - c)‖ ∧ 2 / 100 ≤ ‖d - conj c‖ ∧
      2 / 100 ≤ ‖d - (1 - conj c)‖ := by
  have e1 : (d - c).im = d.im - c.im := by simp
  have e2 : (d - (1 - c)).im = d.im + c.im := by simp
  have e3 : (d - conj c).im = d.im + c.im := by simp
  have e4 : (d - (1 - conj c)).im = d.im - c.im := by simp
  refine ⟨h1.trans ?_, h2.trans ?_, h2.trans ?_, h1.trans ?_⟩
  · rw [← e1]; exact Complex.abs_im_le_norm _
  · rw [← e2]; exact Complex.abs_im_le_norm _
  · rw [← e3]; exact Complex.abs_im_le_norm _
  · rw [← e4]; exact Complex.abs_im_le_norm _

/-- **Four located off-line zeros give a `4`-dimensional negative space of `Q_dh`** (the hypotheses
are the four zero-location certificates). -/
theorem negIndex_ge_four_of (z1 : ∃ ρ, dh ρ = 0 ∧ ‖ρ - cLoc‖ < 1 / 100)
    (z2 : ∃ ρ, dh ρ = 0 ∧ ‖ρ - Z2.cZ‖ < (1 / 200 : ℝ))
    (z3 : ∃ ρ, dh ρ = 0 ∧ ‖ρ - Z3.cZ‖ < (1 / 500 : ℝ))
    (z4 : ∃ ρ, dh ρ = 0 ∧ ‖ρ - Z4.cZ‖ < (1 / 150 : ℝ)) :
    ∃ a, 0 < a ∧ ∃ V : Submodule ℝ (ℝ → ℝ), Module.finrank ℝ V = 4 ∧
      (∀ v ∈ V, Pilot1ca.Probe a v ∧ ∃ K, PilotWeil.StripTest (fun z => Pilot1ca.ghatC v a (3 * z) ^ 2) K) ∧
      ∀ v ∈ V, v ≠ 0 → QDHu v < 0 := by
  refine DHNegIndex.negIndex_ge_of_located cFour (fun k => ?_) (fun k => ?_) (fun k => ?_)
    (fun k l hkl => sep_of_im ?_ ?_)
  · fin_cases k
    · exact z1
    · obtain ⟨ρ, h0, h⟩ := z2; exact ⟨ρ, h0, h.trans_le (by norm_num)⟩
    · obtain ⟨ρ, h0, h⟩ := z3; exact ⟨ρ, h0, h.trans_le (by norm_num)⟩
    · obtain ⟨ρ, h0, h⟩ := z4; exact ⟨ρ, h0, h.trans_le (by norm_num)⟩
  · fin_cases k <;> simp [cFour, cLoc_re, Z2.cZ_re, Z3.cZ_re, Z4.cZ_re] <;> norm_num
  · refine le_abs.2 (Or.inl ?_)
    fin_cases k <;> simp [cFour, cLoc_re, Z2.cZ_re, Z3.cZ_re, Z4.cZ_re] <;> norm_num
  · rw [le_abs]
    fin_cases k <;> fin_cases l <;> simp [cFour, cLoc_im, Z2.cZ_im, Z3.cZ_im, Z4.cZ_im] at hkl ⊢ <;> norm_num
  · refine le_abs.2 (Or.inl ?_)
    fin_cases k <;> fin_cases l <;> simp [cFour, cLoc_im, Z2.cZ_im, Z3.cZ_im, Z4.cZ_im] <;> norm_num

/-- **Four located zeros of `dh` off the critical line** (the four certificates, as stated). -/
theorem dh_zeros_located_four :
    (∃ ρ, dh ρ = 0 ∧ ‖ρ - cLoc‖ < 1 / 100) ∧
    (∃ ρ, dh ρ = 0 ∧ ‖ρ - Z2.cZ‖ < (1 / 200 : ℝ)) ∧
    (∃ ρ, dh ρ = 0 ∧ ‖ρ - Z3.cZ‖ < (1 / 500 : ℝ)) ∧
    (∃ ρ, dh ρ = 0 ∧ ‖ρ - Z4.cZ‖ < (1 / 150 : ℝ)) :=
  ⟨dh_zero_located, dh_zero_located_2, dh_zero_located_3, dh_zero_located_4⟩

/-- **The four located zeros in coordinates** (the four box theorems). -/
theorem dh_zeros_located_four_box :
    (∃ ρ : ℂ, dh ρ = 0 ∧ 1597 / 2000 < ρ.re ∧ ρ.re < 1637 / 2000 ∧
      856893 / 10000 < ρ.im ∧ ρ.im < 857093 / 10000) ∧
    (∃ ρ : ℂ, dh ρ = 0 ∧ 64583 / 100000 < ρ.re ∧ ρ.re < 65583 / 100000 ∧
      5707917 / 50000 < ρ.im ∧ ρ.im < 5708417 / 50000) ∧
    (∃ ρ : ℂ, dh ρ = 0 ∧ 14309 / 25000 < ρ.re ∧ ρ.re < 14409 / 25000 ∧
      16647731 / 100000 < ρ.im ∧ ρ.im < 16648131 / 100000) ∧
    (∃ ρ : ℂ, dh ρ = 0 ∧ 107639 / 150000 < ρ.re ∧ ρ.re < 109639 / 150000 ∧
      26504369 / 150000 < ρ.im ∧ ρ.im < 26506369 / 150000) :=
  ⟨dh_zero_located_box, dh_zero_located_box_2, dh_zero_located_box_3, dh_zero_located_box_4⟩

end PsiOmega.Locate

namespace DHNegIndex

open Pilot1ca Pilot1bt PilotWeil PsiOmega

/-- **The Weil index of `Q_dh` is at least `4`**: a support `a` and a `4`-dimensional space of probes at
support `a`, each passing the width-3 strip test, on which `QDHu` is negative definite, from the four
located off-line zeros of `dh` (`dh_zeros_located_four`, `negIndex_ge_of_located`). -/
theorem negIndex_ge_four : ∃ a, 0 < a ∧ ∃ V : Submodule ℝ (ℝ → ℝ), Module.finrank ℝ V = 4 ∧
    (∀ v ∈ V, Probe a v ∧ ∃ K, StripTest (fun z => ghatC v a (3 * z) ^ 2) K) ∧
    ∀ v ∈ V, v ≠ 0 → QDHu v < 0 := by
  obtain ⟨z1, z2, z3, z4⟩ := PsiOmega.Locate.dh_zeros_located_four
  exact PsiOmega.Locate.negIndex_ge_four_of z1 z2 z3 z4

end DHNegIndex

#print axioms PsiOmega.Locate.negIndex_ge_four_of
#print axioms PsiOmega.Locate.dh_zeros_located_four
#print axioms PsiOmega.Locate.dh_zeros_located_four_box
#print axioms DHNegIndex.negIndex_ge_four
