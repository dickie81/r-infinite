import Mathlib
import DHPacket

/-! # The verified-numerics toolkit for the certificate (round 261, certificate stage 3, part 0)

Interval arithmetic by lemmas (`mul_bounds`, `add_bounds`, `inv_bounds`); two-sided Taylor bounds for `cos` and
`sin` on `|x| ≤ 1` and `0 ≤ x ≤ 1` respectively, from the alternating series (`cos_bounds`, `sin_bounds`, error `x^12/12!` and `x^13/13!`);
the tail bound of Mathlib's `Real.hasSum_log_one_add_inv`, giving `log(1 + 1/m)` to any precision by rational
arithmetic (`log_one_add_inv_bounds`); and `κ` to fifteen decimals (`kappa_bounds`, from `√5` and the two sines
of round 259). The tables downstream (`DHLogBounds`, `DHTrigBounds`, `DHCoeffs`, `DHTerms`; not the hand-written `DHConstants`) are
generated by `frontier/dh/lean_gen/` from these lemmas and checked by the kernel. -/

namespace PsiOmega.Num

open Real Finset

/-! ## Interval arithmetic -/

theorem mul_lower {x y lo hi : ℝ} (h : lo ≤ x ∧ x ≤ hi) : min (lo * y) (hi * y) ≤ x * y := by
  rcases le_total 0 y with hy | hy
  · exact (min_le_left _ _).trans (mul_le_mul_of_nonneg_right h.1 hy)
  · exact (min_le_right _ _).trans (mul_le_mul_of_nonpos_right h.2 hy)

theorem mul_upper {x y lo hi : ℝ} (h : lo ≤ x ∧ x ≤ hi) : x * y ≤ max (lo * y) (hi * y) := by
  rcases le_total 0 y with hy | hy
  · exact (mul_le_mul_of_nonneg_right h.2 hy).trans (le_max_right _ _)
  · exact (mul_le_mul_of_nonpos_right h.1 hy).trans (le_max_left _ _)

/-- **Interval product**: the product of two bounded reals lies between the extreme corner products. -/
theorem mul_bounds {x y lo₁ hi₁ lo₂ hi₂ : ℝ} (h₁ : lo₁ ≤ x ∧ x ≤ hi₁) (h₂ : lo₂ ≤ y ∧ y ≤ hi₂) :
    min (min (lo₁ * lo₂) (lo₁ * hi₂)) (min (hi₁ * lo₂) (hi₁ * hi₂)) ≤ x * y ∧
      x * y ≤ max (max (lo₁ * lo₂) (lo₁ * hi₂)) (max (hi₁ * lo₂) (hi₁ * hi₂)) := by
  constructor
  · refine le_trans ?_ (mul_lower h₁)
    have a := mul_lower (x := y) (y := lo₁) h₂
    have b := mul_lower (x := y) (y := hi₁) h₂
    rw [mul_comm y lo₁, mul_comm lo₂ lo₁, mul_comm hi₂ lo₁] at a
    rw [mul_comm y hi₁, mul_comm lo₂ hi₁, mul_comm hi₂ hi₁] at b
    exact le_min ((min_le_left _ _).trans a) ((min_le_right _ _).trans b)
  · refine (mul_upper h₁).trans ?_
    have a := mul_upper (x := y) (y := lo₁) h₂
    have b := mul_upper (x := y) (y := hi₁) h₂
    rw [mul_comm y lo₁, mul_comm lo₂ lo₁, mul_comm hi₂ lo₁] at a
    rw [mul_comm y hi₁, mul_comm lo₂ hi₁, mul_comm hi₂ hi₁] at b
    exact max_le (a.trans (le_max_left _ _)) (b.trans (le_max_right _ _))

theorem add_bounds {x y lo₁ hi₁ lo₂ hi₂ : ℝ} (h₁ : lo₁ ≤ x ∧ x ≤ hi₁) (h₂ : lo₂ ≤ y ∧ y ≤ hi₂) :
    lo₁ + lo₂ ≤ x + y ∧ x + y ≤ hi₁ + hi₂ :=
  ⟨add_le_add h₁.1 h₂.1, add_le_add h₁.2 h₂.2⟩

theorem neg_bounds {x lo hi : ℝ} (h : lo ≤ x ∧ x ≤ hi) : -hi ≤ -x ∧ -x ≤ -lo :=
  ⟨neg_le_neg h.2, neg_le_neg h.1⟩

theorem inv_bounds {x lo hi : ℝ} (h : lo ≤ x ∧ x ≤ hi) (hlo : 0 < lo) : hi⁻¹ ≤ x⁻¹ ∧ x⁻¹ ≤ lo⁻¹ :=
  ⟨inv_anti₀ (hlo.trans_le h.1) h.2, inv_anti₀ hlo h.1⟩

/-! ## `cos` on `|x| ≤ 1` and `sin` on `0 ≤ x ≤ 1` by the alternating series -/

/-- `Σ_{i<6} (−1)^i x^{2i}/(2i)! ≤ cos x ≤ Σ_{i<7} (−1)^i x^{2i}/(2i)!` for `|x| ≤ 1`. -/
theorem cos_bounds {x : ℝ} (hx : |x| ≤ 1) :
    ∑ i ∈ range (2 * 3), (-1 : ℝ) ^ i * (x ^ (2 * i) / ((2 * i).factorial : ℝ)) ≤ Real.cos x ∧
      Real.cos x ≤ ∑ i ∈ range (2 * 3 + 1), (-1 : ℝ) ^ i * (x ^ (2 * i) / ((2 * i).factorial : ℝ)) := by
  set f : ℕ → ℝ := fun i => x ^ (2 * i) / ((2 * i).factorial : ℝ) with hfdef
  have hx2 : x ^ 2 ≤ 1 := by
    have := abs_le.1 hx
    nlinarith [sq_abs x, abs_nonneg x]
  have hf : Antitone f := by
    refine antitone_nat_of_succ_le fun n => ?_
    simp only [hfdef]
    have h0 : 0 ≤ x ^ (2 * n) := by rw [pow_mul]; positivity
    have hnum : x ^ (2 * (n + 1)) ≤ x ^ (2 * n) := by
      rw [show 2 * (n + 1) = 2 * n + 2 by ring, pow_add]
      exact mul_le_of_le_one_right h0 hx2
    have hden : ((2 * n).factorial : ℝ) ≤ ((2 * (n + 1)).factorial : ℝ) := by
      exact_mod_cast Nat.factorial_le (by omega)
    calc x ^ (2 * (n + 1)) / ((2 * (n + 1)).factorial : ℝ)
        ≤ x ^ (2 * n) / ((2 * (n + 1)).factorial : ℝ) :=
          div_le_div_of_nonneg_right hnum (by positivity)
      _ ≤ x ^ (2 * n) / ((2 * n).factorial : ℝ) :=
          div_le_div_of_nonneg_left h0 (by positivity) hden
  have hl := (Real.hasSum_cos x).tendsto_sum_nat
  have e : (fun n : ℕ => (-1 : ℝ) ^ n * x ^ (2 * n) / ((2 * n).factorial : ℝ))
      = fun i => (-1 : ℝ) ^ i * f i := by
    funext i; simp only [hfdef]; ring
  rw [e] at hl
  exact ⟨hf.alternating_series_le_tendsto hl 3, hf.tendsto_le_alternating_series hl 3⟩

/-- `Σ_{i<6} (−1)^i x^{2i+1}/(2i+1)! ≤ sin x ≤ Σ_{i<7} (−1)^i x^{2i+1}/(2i+1)!` for `0 ≤ x ≤ 1`. -/
theorem sin_bounds {x : ℝ} (hx0 : 0 ≤ x) (hx : x ≤ 1) :
    ∑ i ∈ range (2 * 3), (-1 : ℝ) ^ i * (x ^ (2 * i + 1) / ((2 * i + 1).factorial : ℝ)) ≤ Real.sin x ∧
      Real.sin x ≤ ∑ i ∈ range (2 * 3 + 1),
        (-1 : ℝ) ^ i * (x ^ (2 * i + 1) / ((2 * i + 1).factorial : ℝ)) := by
  set f : ℕ → ℝ := fun i => x ^ (2 * i + 1) / ((2 * i + 1).factorial : ℝ) with hfdef
  have hx2 : x ^ 2 ≤ 1 := by nlinarith
  have hf : Antitone f := by
    refine antitone_nat_of_succ_le fun n => ?_
    simp only [hfdef]
    have h0 : 0 ≤ x ^ (2 * n + 1) := by positivity
    have hnum : x ^ (2 * (n + 1) + 1) ≤ x ^ (2 * n + 1) := by
      rw [show 2 * (n + 1) + 1 = 2 * n + 1 + 2 by ring, pow_add]
      exact mul_le_of_le_one_right h0 hx2
    have hden : ((2 * n + 1).factorial : ℝ) ≤ ((2 * (n + 1) + 1).factorial : ℝ) := by
      exact_mod_cast Nat.factorial_le (by omega)
    calc x ^ (2 * (n + 1) + 1) / ((2 * (n + 1) + 1).factorial : ℝ)
        ≤ x ^ (2 * n + 1) / ((2 * (n + 1) + 1).factorial : ℝ) :=
          div_le_div_of_nonneg_right hnum (by positivity)
      _ ≤ x ^ (2 * n + 1) / ((2 * n + 1).factorial : ℝ) :=
          div_le_div_of_nonneg_left h0 (by positivity) hden
  have hl := (Real.hasSum_sin x).tendsto_sum_nat
  have e : (fun n : ℕ => (-1 : ℝ) ^ n * x ^ (2 * n + 1) / ((2 * n + 1).factorial : ℝ))
      = fun i => (-1 : ℝ) ^ i * f i := by
    funext i; simp only [hfdef]; ring
  rw [e] at hl
  exact ⟨hf.alternating_series_le_tendsto hl 3, hf.tendsto_le_alternating_series hl 3⟩

/-! ## `log(1 + 1/m)` by Mathlib's series, with the tail -/

/-- Two-sided bounds for `log(1 + 1/m)` from `K` terms of `Real.hasSum_log_one_add_inv`. -/
theorem log_one_add_inv_bounds {m : ℕ} (hm : 0 < m) (K : ℕ) :
    ∑ k ∈ range K, 2 * (1 / (2 * (k : ℝ) + 1)) * (1 / (2 * (m : ℝ) + 1)) ^ (2 * k + 1)
        ≤ Real.log (1 + (m : ℝ)⁻¹) ∧
      Real.log (1 + (m : ℝ)⁻¹)
        ≤ ∑ k ∈ range K, 2 * (1 / (2 * (k : ℝ) + 1)) * (1 / (2 * (m : ℝ) + 1)) ^ (2 * k + 1)
          + 2 * (1 / (2 * (m : ℝ) + 1)) ^ (2 * K + 1) / (1 - (1 / (2 * (m : ℝ) + 1)) ^ 2) := by
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  have hs := Real.hasSum_log_one_add_inv hm'
  set q : ℝ := 1 / (2 * (m : ℝ) + 1) with hq
  have hq0 : 0 ≤ q := by positivity
  have hq1 : q < 1 := by rw [hq, div_lt_one (by positivity)]; linarith
  have hterm : ∀ k : ℕ, 0 ≤ 2 * (1 / (2 * (k : ℝ) + 1)) * q ^ (2 * k + 1) := fun k => by positivity
  refine ⟨sum_le_hasSum (range K) (fun i _ => hterm i) hs, ?_⟩
  have hsum := hs.summable
  have key := hsum.sum_add_tsum_nat_add K
  rw [hs.tsum_eq] at key
  rw [← key]
  gcongr
  have hq2 : q ^ 2 < 1 := by nlinarith
  have hg : HasSum (fun i : ℕ => 2 * q ^ (2 * K + 1) * (q ^ 2) ^ i)
      (2 * q ^ (2 * K + 1) * (1 - q ^ 2)⁻¹) :=
    (hasSum_geometric_of_lt_one (by positivity) hq2).mul_left _
  have hshift : HasSum (fun i : ℕ => 2 * (1 / (2 * ((i + K : ℕ) : ℝ) + 1)) * q ^ (2 * (i + K) + 1))
      (∑' i : ℕ, 2 * (1 / (2 * ((i + K : ℕ) : ℝ) + 1)) * q ^ (2 * (i + K) + 1)) :=
    ((summable_nat_add_iff K).2 hsum).hasSum
  rw [div_eq_mul_inv]
  refine hasSum_le (fun i => ?_) hshift hg
  have h1 : 1 / (2 * ((i + K : ℕ) : ℝ) + 1) ≤ 1 := by
    rw [div_le_one (by positivity)]; linarith [(Nat.cast_nonneg (i + K) : (0 : ℝ) ≤ (i + K : ℕ))]
  have h2 : q ^ (2 * (i + K) + 1) = q ^ (2 * K + 1) * (q ^ 2) ^ i := by
    rw [← pow_mul, ← pow_add]; congr 1; ring
  rw [h2]
  have hp : 0 ≤ q ^ (2 * K + 1) * (q ^ 2) ^ i := by positivity
  calc 2 * (1 / (2 * ((i + K : ℕ) : ℝ) + 1)) * (q ^ (2 * K + 1) * (q ^ 2) ^ i)
      ≤ 2 * 1 * (q ^ (2 * K + 1) * (q ^ 2) ^ i) := by gcongr
    _ = 2 * q ^ (2 * K + 1) * (q ^ 2) ^ i := by ring

end PsiOmega.Num

