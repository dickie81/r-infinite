namespace PsiOmega

open Real

theorem sqrt_five_bounds :
    (22360679774997896 : ℝ) / 10 ^ 16 < Real.sqrt 5 ∧ Real.sqrt 5 < (22360679774997897 : ℝ) / 10 ^ 16 := by
  constructor
  · rw [Real.lt_sqrt (by norm_num)]; norm_num
  · rw [Real.sqrt_lt' (by norm_num)]; norm_num

theorem sin_pi_div_five_bounds :
    (5877852522924731 : ℝ) / 10 ^ 16 < Real.sin (π / 5) ∧ Real.sin (π / 5) < (5877852522924732 : ℝ) / 10 ^ 16 := by
  have h5 := sqrt_five_bounds
  rw [sin_pi_div_five_eq]
  constructor
  · rw [Real.lt_sqrt (by linarith)]; nlinarith [h5.1, h5.2]
  · rw [Real.sqrt_lt' (by norm_num)]; nlinarith [h5.1, h5.2]

theorem sin_two_pi_div_five_bounds :
    (9510565162951535 : ℝ) / 10 ^ 16 < Real.sin (2 * π / 5) ∧
      Real.sin (2 * π / 5) < (9510565162951536 : ℝ) / 10 ^ 16 := by
  have h5 := sqrt_five_bounds
  rw [sin_two_pi_div_five_eq]
  constructor
  · rw [Real.lt_sqrt (by linarith)]; nlinarith [h5.1, h5.2]
  · rw [Real.sqrt_lt' (by norm_num)]; nlinarith [h5.1, h5.2]

/-- `κ = 0.284079043840412…` -/
theorem kappa_bounds :
    (284079043840412 : ℝ) / 10 ^ 15 < kappa ∧ kappa < (284079043840413 : ℝ) / 10 ^ 15 := by
  have h5 := sqrt_five_bounds
  have h1 := sin_pi_div_five_bounds
  have h2 := sin_two_pi_div_five_bounds
  unfold kappa
  have hden : 0 < Real.sqrt 5 + 2 * Real.sin (2 * π / 5) := by linarith
  constructor
  · rw [lt_div_iff₀ hden]; nlinarith
  · rw [div_lt_iff₀ hden]; nlinarith

end PsiOmega

