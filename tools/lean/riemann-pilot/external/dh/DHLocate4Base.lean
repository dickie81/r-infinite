/-- **The second-derivative bound on the ball**: `‖DEM″ + GEM″‖ ≤ 448153 / 4900` on `closedBall cZ (1 / 150)`. -/
theorem m2_ball {z : ℂ} (hz : z ∈ closedBall cZ (1 / 150 : ℝ)) :
    ‖DEMk 2 41 z + deriv (deriv (GEM 41 12)) z‖ ≤ (448153 / 4900 : ℝ) := by
  have h := norm_deriv2_fEM_ballG 41 12 (c := cZ) (r := (1 / 150 : ℝ)) (R := (7 / 20 : ℝ)) (σd := (107639 / 150000 : ℝ))
    (σ₀ := (55139 / 150000 : ℝ)) (σ₁ := (162139 / 150000 : ℝ)) (τ := (26558869 / 150000 : ℝ)) (τ₀ := (26451869 / 150000 : ℝ)) (C := (471 / 1000 : ℝ)) (d₂ := (8377 / 100 : ℝ))
    (by rw [cZ_re]; norm_num) D2sum_le (by norm_num) (by norm_num) (by norm_num) (by rw [cZ_re]; norm_num)
    (by rw [cZ_re]; norm_num) (by rw [cZ_im]; norm_num) (by rw [cZ_im]; norm_num) Gsup_ball_le hz
  refine h.trans (le_of_eq ?_)
  norm_num

